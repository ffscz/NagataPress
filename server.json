{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ffscz/nagatapress",
  "title": "NagataPress",
  "description": "Translate a WordPress or WooCommerce site with your AI assistant, over MCP on your own site.",
  "version": "1.3.24",
  "websiteUrl": "https://nagatapress.com/translate-woocommerce-with-claude-chatgpt/",
  "repository": {
    "url": "https://github.com/ffscz/NagataPress",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://nagatapress.com/wp-content/uploads/2026/10/nagatapress-site-icon-e3a2abfb-192x192.png",
      "mimeType": "image/png",
      "sizes": [
        "192x192"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://{site}/wp-json/nagatapress/v1/mcp",
      "variables": {
        "site": {
          "description": "Domain of your WordPress site with the NagataPress plugin, for example shop.example.com",
          "isRequired": true
        }
      }
    }
  ]
}
